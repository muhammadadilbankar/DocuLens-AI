DOCULENS_APP_NAME=DocuLens AI API
DOCULENS_ENVIRONMENT=development
DOCULENS_DEBUG=true
DOCULENS_FRONTEND_URL=http://127.0.0.1:5173
DOCULENS_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/doculens
DOCULENS_UPLOAD_DIRECTORY=uploads
DOCULENS_PROCESSED_DIRECTORY=processed
DOCULENS_MAX_UPLOAD_SIZE_MB=50
DOCULENS_PDF_RENDER_DPI=150
DOCULENS_PREPROCESSING_MIN_WIDTH=1600
DOCULENS_DENOISE_STRENGTH=7
DOCULENS_MAX_DESKEW_ANGLE=5.0
DOCULENS_OCR_DEVICE=cpu
DOCULENS_OCR_ENABLE_MKLDNN=false
DOCULENS_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
DOCULENS_OCR_RECOGNITION_MODEL=en_PP-OCRv5_mobile_rec
DOCULENS_OCR_MIN_CONFIDENCE=0.25
DOCULENS_MODEL_CACHE_DIRECTORY=models_cache
DOCULENS_OCR_MODEL_SOURCE=BOS
# Set both paths to downloaded inference-model directories for explicit offline loading.
# DOCULENS_OCR_DETECTION_MODEL_DIR=C:/models/PP-OCRv5_mobile_det
# DOCULENS_OCR_RECOGNITION_MODEL_DIR=C:/models/en_PP-OCRv5_mobile_rec
DOCULENS_SPACY_MODEL=en_core_web_sm
DOCULENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCULENS_EMBEDDING_MODEL_DIRECTORY=models_cache/all-MiniLM-L6-v2
DOCULENS_SEARCH_INDEX_DIRECTORY=search_indexes
DOCULENS_CHUNK_SIZE_WORDS=120
DOCULENS_CHUNK_OVERLAP_WORDS=25
DOCULENS_SEARCH_DEFAULT_LIMIT=5
DOCULENS_SEARCH_MAX_LIMIT=20
