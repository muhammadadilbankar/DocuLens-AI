DOCULENS_APP_NAME=DocuLens AI API
DOCULENS_ENVIRONMENT=development
DOCULENS_DEBUG=true
DOCULENS_FRONTEND_URL=http://127.0.0.1:5173
DOCULENS_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/doculens
DOCULENS_UPLOAD_DIRECTORY=uploads
DOCULENS_PROCESSED_DIRECTORY=processed
DOCULENS_MAX_UPLOAD_SIZE_MB=50
DOCULENS_PDF_RENDER_DPI=150
DOCULENS_PREPROCESSING_MIN_WIDTH=1600
DOCULENS_DENOISE_STRENGTH=7
DOCULENS_MAX_DESKEW_ANGLE=5.0
